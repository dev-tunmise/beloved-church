# Beloved Church Website - Environment Variables
# For local development: Copy this file to .env.local and fill in your actual values
# For Vercel deployment: Add these in Project Settings > Environment Variables

# Stripe Payment Integration (for Giving & Shop)
# Optional - Leave blank if not using payments yet
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# YouTube API (optional - for advanced features)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://belovedchurch.org
NEXT_PUBLIC_SITE_NAME=Beloved Church

# Contact Information
NEXT_PUBLIC_CHURCH_EMAIL=info@belovedchurch.org
NEXT_PUBLIC_CHURCH_PHONE=+1-555-123-4567
NEXT_PUBLIC_WHATSAPP_NUMBER=+1234567890

# Social Media Links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/belovedchurch
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@belovedchurch
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/belovedchurch
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/belovedchurch

# Email Service (for contact form - optional)
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@belovedchurch.org
EMAIL_TO=admin@belovedchurch.org

# Database (if you add one later)
# DATABASE_URL=your_database_connection_string
